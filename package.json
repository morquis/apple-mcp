{
  "name": "apple-mcp",
  "version": "0.2.7",
  "module": "index.ts",
  "type": "module",
  "description": "Apple MCP tools for contacts, notes, messages, and mail integration",
  "author": "Dhravya Shah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhravya/apple-mcp.git"
  },
  "keywords": [
    "mcp",
    "apple",
    "contacts",
    "notes",
    "messages",
    "mail",
    "claude"
  ],
  "bin": {
    "apple-mcp": "./dist/index.js"
  },
  "scripts": {
    "dev": "bun run index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "bun x eslint . --ext .ts",
    "test": "bun test utils/ core/ tests/basic.test.ts tests/mail-header-filter.test.ts",
    "test:integration": "APPLE_MCP_INTEGRATION=1 bun test --concurrency 1 tests/integration/",
    "test:integration:notes": "APPLE_MCP_INTEGRATION=1 bun test tests/integration/notes.integration.test.ts",
    "test:integration:reminders": "APPLE_MCP_INTEGRATION=1 bun test tests/integration/reminders.integration.test.ts",
    "test:integration:calendar": "APPLE_MCP_INTEGRATION=1 bun test tests/integration/calendar.integration.test.ts",
    "test:integration:mail": "APPLE_MCP_INTEGRATION=1 bun test tests/integration/mail.integration.test.ts",
    "test:integration:contacts": "APPLE_MCP_INTEGRATION=1 bun test tests/integration/contacts.integration.test.ts",
    "test:all": "bun test utils/ core/ tests/basic.test.ts tests/mail-header-filter.test.ts && APPLE_MCP_INTEGRATION=1 bun test --concurrency 1 tests/integration/",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "eslint": "^8.56.0"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@jxa/global-type": "^1.3.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/express": "^5.0.0",
    "better-sqlite3": "^12.9.0",
    "mcp-proxy": "^2.4.0",
    "zod": "^3.25.76"
  }
}
